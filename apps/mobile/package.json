{
  "name": "ai-language-partner-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "verify": "npm run typecheck && npm run verify:frontend-regressions && npm run verify:readme-scripts",
    "typecheck": "tsc --noEmit",
    "verify:frontend-regressions": "node scripts/verify-frontend-regressions.mjs",
    "verify:prod-no-secret": "node scripts/verify-prod-no-attestation-secret.mjs",
    "verify:readme-scripts": "node scripts/verify-readme-scripts.mjs && node scripts/test-verify-readme-scripts.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@react-native-async-storage/async-storage": "2.1.2",
    "expo": "~53.0.27",
    "expo-asset": "~11.1.7",
    "expo-audio": "~0.4.9",
    "expo-file-system": "~18.1.11",
    "expo-haptics": "~14.1.4",
    "expo-speech": "~13.1.7",
    "expo-status-bar": "~2.2.3",
    "fflate": "^0.8.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13",
    "postcss": "8.5.10",
    "tar": "7.5.16",
    "uuid": "11.1.1"
  }
}
